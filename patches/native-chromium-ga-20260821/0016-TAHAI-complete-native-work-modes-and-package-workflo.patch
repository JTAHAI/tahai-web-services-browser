+namespace tahai {
+namespace {
+
+constexpr std::array<WorkModeDefinition, 6> kDefinitions = {{
+    {"daily", "Daily Driver", "Everyday personal and professional browsing",
+     "Browse naturally. Keep the browser clean.", "1-up or lightweight 2-up",
