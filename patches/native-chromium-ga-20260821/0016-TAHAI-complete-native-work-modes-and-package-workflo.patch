+  mission->timeline.insert(mission->timeline.begin(),
+                           {std::string(kind), std::move(detail), now});
+  if (mission->timeline.size() > kMaximumTimelineEvents) {
+    mission->timeline.resize(kMaximumTimelineEvents);
+  }
+  mission->updated_at = now;
+}
