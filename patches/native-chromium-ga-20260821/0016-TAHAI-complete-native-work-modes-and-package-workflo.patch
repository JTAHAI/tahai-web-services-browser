+</Package>
diff --git a/chrome/installer/win/tahai_msix/package_unsigned_msix.ps1 b/chrome/installer/win/tahai_msix/package_unsigned_msix.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..b183a3d40ca3075291999238bd0a300738cdd314
--- /dev/null
+++ b/chrome/installer/win/tahai_msix/package_unsigned_msix.ps1
@@ -0,0 +1,80 @@
+[CmdletBinding()]
+param(
+    [string]$OutDir = (Join-Path $PSScriptRoot "out"),
+    [string]$BuildDir = (Join-Path $PSScriptRoot "..\..\..\..\out\tahai_stock_debug_x64"),
+    [string]$Version = "0.1.0.0"
+)
+
+$ErrorActionPreference = "Stop"
+
+function Copy-RequiredFile {
+    param([string]$Name)
+    $source = Join-Path $BuildDir $Name
+    if (-not (Test-Path -LiteralPath $source -PathType Leaf)) {
+        throw "Required TAHAI runtime file is missing: $source"
+    }
+    Copy-Item -LiteralPath $source -Destination $stage -Force
+}
+
+function Copy-RequiredDirectory {
+    param([string]$Name)
+    $source = Join-Path $BuildDir $Name
+    if (-not (Test-Path -LiteralPath $source -PathType Container)) {
+        throw "Required TAHAI runtime directory is missing: $source"
+    }
+    Copy-Item -LiteralPath $source -Destination $stage -Recurse -Force
+}
+
+$sdkRoot = "${env:ProgramFiles(x86)}\Windows Kits\10\bin"
+$makeAppx = Get-ChildItem -LiteralPath $sdkRoot -Recurse -Filter MakeAppx.exe |
+    Where-Object { $_.FullName -match "\\x64\\MakeAppx\.exe$" } |
+    Sort-Object FullName -Descending |
+    Select-Object -First 1 -ExpandProperty FullName
+if (-not $makeAppx) {
+    throw "MakeAppx.exe was not found under $sdkRoot. Install the Windows SDK packaging tools."
+}
+
+$resolvedBuildDir = (Resolve-Path -LiteralPath $BuildDir).Path
+$resolvedOutDir = [System.IO.Path]::GetFullPath($OutDir)
+$stage = Join-Path $resolvedOutDir "stage"
+$package = Join-Path $resolvedOutDir "TAHAI-Browser_$Version`_x64_unsigned.msix"
+
+if (Test-Path -LiteralPath $stage) {
+    Remove-Item -LiteralPath $stage -Recurse -Force
+}
+New-Item -ItemType Directory -Path $stage -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $stage "Assets") -Force | Out-Null
+
+foreach ($file in @(
+    "chrome.exe", "chrome.dll", "chrome_elf.dll", "150.0.7871.186.manifest", "chrome_100_percent.pak",
+    "chrome_200_percent.pak", "d3dcompiler_47.dll", "dxcompiler.dll", "dxil.dll",
+    "icudtl.dat", "libEGL.dll", "libGLESv2.dll", "resources.pak",
+    "v8_context_snapshot.bin", "vk_swiftshader.dll", "vk_swiftshader_icd.json",
+    "vulkan-1.dll", "notification_helper.exe", "msvcp140d.dll",
+    "msvcp140d_atomic_wait.dll", "ucrtbased.dll", "vcruntime140d.dll",
+    "vcruntime140_1d.dll")) {
+    Copy-RequiredFile $file
+}
+foreach ($directory in @("locales", "resources", "MEIPreload")) {
+    Copy-RequiredDirectory $directory
+}
+
+Copy-Item -LiteralPath (Join-Path $PSScriptRoot "AppxManifest.xml") -Destination (Join-Path $stage "AppxManifest.xml") -Force
+$tiles = Join-Path $PSScriptRoot "..\..\..\app\theme\tahai\win\tiles"
+Copy-Item -LiteralPath (Join-Path $tiles "Logo.png") -Destination (Join-Path $stage "Assets\Logo.png") -Force
+Copy-Item -LiteralPath (Join-Path $tiles "SmallLogo.png") -Destination (Join-Path $stage "Assets\SmallLogo.png") -Force
+Copy-Item -LiteralPath (Join-Path $tiles "SmallLogo.png") -Destination (Join-Path $stage "Assets\StoreLogo.png") -Force
+Copy-Item -LiteralPath (Join-Path $tiles "Logo.png") -Destination (Join-Path $stage "Assets\WideLogo.png") -Force
+
+if (Test-Path -LiteralPath $package) {
+    Remove-Item -LiteralPath $package -Force
+}
+& $makeAppx pack /d $stage /p $package /o
+if ($LASTEXITCODE -ne 0) {
+    throw "MakeAppx packaging failed with exit code $LASTEXITCODE."
+}
+& $makeAppx unpack /p $package /d (Join-Path $resolvedOutDir "validation") /o
+if ($LASTEXITCODE -ne 0) {
+    throw "MakeAppx validation unpack failed with exit code $LASTEXITCODE."
+}
+Get-Item -LiteralPath $package | Select-Object FullName, Length, LastWriteTime
