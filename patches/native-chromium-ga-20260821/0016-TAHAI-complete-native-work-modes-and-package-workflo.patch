+// Keep the ordinary Chromium new-tab command as the product entry point, but
+// route a regular profile to TAHAI's trusted, browser-owned launchpad. The
+// managed NewTabPageLocation policy handler is registered first and therefore
+// remains authoritative. Incognito deliberately retains Chromium's normal
+// private new-tab surface: Mission Control is profile-scoped persistent state
+// and must never become an implicit private-browsing feature.
+bool HandleTahaiNewTabURL(GURL* url,
+                          content::BrowserContext* browser_context) {
+  // Compare the canonical Chrome WebUI host rather than a full GURL. The
+  // browser's new-tab command may carry an equivalent trailing slash, while
+  // the product route must still win after managed NewTabPageLocation policy
+  // has had its chance to override it.
+  if (!url || !url->SchemeIs(content::kChromeUIScheme) ||
+      url->host() != chrome::kChromeUINewTabHost) {
+    return false;
+  }
+
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (profile->IsOffTheRecord()) {
+    return false;
+  }
+
+  *url = GURL(tahai::kTahaiTrustedNewTabURL);
+  return true;
+}
+
+// TAHAI's public scheme is only a browser-side alias. It is deliberately
+// rewritten before loading to the existing trusted WebUI host, so registering
+// tahai:// never creates a renderer-loadable or independently privileged
+// scheme. Only the fixed product routes below are accepted; credentials,
+// ports, queries, fragments, and arbitrary paths are rejected.
+bool HandleTahaiPublicURL(GURL* url,
+                          content::BrowserContext* browser_context) {
+  if (!url || !url->SchemeIs(tahai::kTahaiScheme) || url->has_username() ||
+      url->has_password() || url->has_port() || url->has_query() ||
+      url->has_ref() || url->path() != "/") {
+    return false;
+  }
+
+  const std::string_view host = url->host();
+  const char* trusted_url = nullptr;
+  if (host == "home") {
+    trusted_url = tahai::kTahaiTrustedNewTabURL;
+  } else if (host == "mission") {
+    trusted_url = tahai::kTahaiTrustedMissionURL;
+  } else if (host == "commands") {
+    trusted_url = tahai::kTahaiTrustedOpsToolsURL;
+  } else if (host == "profiles") {
+    trusted_url = tahai::kTahaiTrustedProfilesURL;
+  } else if (host == "support") {
+    trusted_url = tahai::kTahaiTrustedSupportURL;
+  } else if (host == "policy") {
+    trusted_url = tahai::kTahaiTrustedPolicyURL;
+  } else if (host == "modes") {
+    trusted_url = tahai::kTahaiTrustedModesURL;
+  } else {
+    return false;
+  }
+
+  *url = GURL(trusted_url);
+  return true;
+}
+
+bool ReverseTahaiPublicURL(GURL* url,
+                           content::BrowserContext* browser_context) {
+  if (!url || !url->SchemeIs(content::kChromeUIScheme) ||
+      url->host() != tahai::kTahaiChromeHost || url->has_query() ||
+      url->has_ref()) {
+    return false;
+  }
+
+  const std::string_view path = url->path();
+  const char* public_url = nullptr;
+  if (path == "/") {
+    public_url = tahai::kTahaiNewTabURL;
+  } else if (path == "/mission/") {
+    public_url = tahai::kTahaiMissionURL;
+  } else if (path == "/ops-tools/") {
+    public_url = tahai::kTahaiOpsToolsURL;
+  } else if (path == "/profiles/") {
+    public_url = tahai::kTahaiProfilesURL;
+  } else if (path == "/support/") {
+    public_url = tahai::kTahaiSupportURL;
+  } else if (path == "/policy/") {
+    public_url = tahai::kTahaiPolicyURL;
+  } else if (path == "/modes/") {
+    public_url = tahai::kTahaiModesURL;
+  } else {
+    return false;
+  }
+
+  *url = GURL(public_url);
+  return true;
+}
