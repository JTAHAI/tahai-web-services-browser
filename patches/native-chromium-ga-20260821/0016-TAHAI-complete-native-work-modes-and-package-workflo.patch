+std::string_view RecommendedLayoutCommand(std::string_view mode) {
+  if (mode == "creator") {
+    return "tri.one-over-two";
+  }
+  if (mode == "builder") {
+    return "tri.two-over-one";
+  }
+  if (mode == "operator") {
+    return "quad.open";
+  }
+  if (mode == "research") {
+    return "dual.open";
+  }
+  if (mode == "support") {
+    return "tri.one-over-two";
+  }
+  return "quad.exit";
+}
