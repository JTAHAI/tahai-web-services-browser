+    return false;
+  }
+  MissionStep& step = (*steps)[step_index];
+  step.complete = !step.complete;
+  AppendGeneratedEvent(mission, timeline_kind,
+                       base::StrCat({label, step.complete ? " completed: "
+                                                        : " reopened: ",
+                                     step.label}));
+  return true;
+}
