@@ -16730,6 +16730,15 @@ Please help our engineers fix this problem. Tell us what happened right before y
       <message name="IDS_TAB_AX_LABEL_SPLIT_TAB_RIGHT_VIEW_FORMAT" desc="Accessibility label text for a tab, when it is the right tab of a split view. Example: 'Google Search - Right view'">
         <ph name="WINDOW_TITLE">$1<ex>Google Search</ex></ph> - Right view
       </message>
+      <message name="IDS_TAB_AX_LABEL_SPLIT_TAB_TOP_VIEW_FORMAT" desc="Accessibility label text for a tab, when it is the top tab of a stacked split view. Example: 'Google Search - Top view'">
+        <ph name="WINDOW_TITLE">$1<ex>Google Search</ex></ph> - Top view
+      </message>
+      <message name="IDS_TAB_AX_LABEL_SPLIT_TAB_BOTTOM_VIEW_FORMAT" desc="Accessibility label text for a tab, when it is the bottom tab of a stacked split view. Example: 'Google Search - Bottom view'">
+        <ph name="WINDOW_TITLE">$1<ex>Google Search</ex></ph> - Bottom view
+      </message>
+      <message name="IDS_TAB_AX_LABEL_TAHAI_QUAD_VIEW_PANE_FORMAT" desc="Accessibility label text for a tab in a TAHAI multi-view workspace. Example: 'Google Search - Multi-View pane 2 of 4'">
+        <ph name="WINDOW_TITLE">$1<ex>Google Search</ex></ph> - Multi-View pane <ph name="PANE_NUMBER">$2<ex>2</ex></ph> of <ph name="PANE_COUNT">$3<ex>4</ex></ph>
+      </message>
       <message name="IDS_TAB_AX_LABEL_UNNAMED_GROUP_FORMAT" desc="Accessibility label text for a tab, when it is in a group that has not been named by the user. Example: 'Google Search - Part of unnamed group'">
         <ph name="WINDOW_TITLE">$1<ex>Google Search</ex></ph> - Part of unnamed group
       </message>
@@ -19986,14 +19995,47 @@ Please help our engineers fix this problem. Tell us what happened right before y
     <message name="IDS_TAHAI_OPEN_QUAD_VIEW" desc="The app menu command that opens TAHAI's native four-pane tab workspace.">
       Open Quad View
     </message>
-    <message name="IDS_TAHAI_FOCUS_ACTIVE_PANE" desc="The app menu command that temporarily expands the active pane in Quad View.">
+    <message name="IDS_TAHAI_OPEN_DUAL_VIEW" desc="The app menu command that opens TAHAI's native two-pane side-by-side workspace.">
+      Open Dual View — Side by Side
+    </message>
+    <message name="IDS_TAHAI_OPEN_DUAL_VIEW_STACKED" desc="The app menu command that opens TAHAI's native two-pane stacked workspace.">
+      Open Dual View — Stacked
+    </message>
+    <message name="IDS_TAHAI_OPEN_TRI_VIEW_TWO_OVER_ONE" desc="The app menu command that opens TAHAI's native three-pane workspace with two panes above one.">
+      Open Tri View — 2 over 1
+    </message>
+    <message name="IDS_TAHAI_OPEN_TRI_VIEW_ONE_OVER_TWO" desc="The app menu command that opens TAHAI's native three-pane workspace with one pane above two.">
+      Open Tri View — 1 over 2
+    </message>
+    <message name="IDS_TAHAI_FOCUS_ACTIVE_PANE" desc="The app menu command that temporarily expands the active pane in a TAHAI multi-view workspace.">
       Focus Active Pane
     </message>
-    <message name="IDS_TAHAI_RESTORE_QUAD_VIEW" desc="The app menu command that restores all panes after focusing one Quad View pane.">
-      Restore Quad View
+    <message name="IDS_TAHAI_RESTORE_QUAD_VIEW" desc="The app menu command that restores all panes after focusing one TAHAI workspace pane.">
+      Restore Multi-View
+    </message>
+    <message name="IDS_TAHAI_EXIT_QUAD_VIEW" desc="The app menu command that exits the current TAHAI multi-view workspace without closing its tabs.">
+      Exit Multi-View
+    </message>
+    <message name="IDS_TAHAI_OPEN_LAUNCHPAD" desc="The app menu command that opens TAHAI's native operator launchpad.">
+      TAHAI Launchpad
+    </message>
+    <message name="IDS_TAHAI_OPEN_MISSION_CONTROL" desc="The app menu command that opens TAHAI Mission Control.">
+      Mission Control
+    </message>
+    <message name="IDS_TAHAI_OPEN_COMMAND_CENTER" desc="The app menu command that opens TAHAI Command Center.">
+      Command Center
+    </message>
+    <message name="IDS_TAHAI_OPEN_WORK_MODES" desc="The app menu command that opens TAHAI Work Modes.">
+      Work Modes
+    </message>
+    <message name="IDS_TAHAI_OPEN_PROFILES" desc="The app menu command that opens TAHAI profile administration.">
+      Profile Administration
+    </message>
+    <message name="IDS_TAHAI_OPEN_SUPPORT" desc="The app menu command that opens TAHAI support.">
+      TAHAI Support
     </message>
-    <message name="IDS_TAHAI_EXIT_QUAD_VIEW" desc="The app menu command that exits TAHAI Quad View without closing its tabs.">
-      Exit Quad View
+    <message name="IDS_TAHAI_OPEN_POLICY" desc="The app menu command that opens TAHAI policy information.">
+      TAHAI Policy
     </message>
   </messages>
 </release>
