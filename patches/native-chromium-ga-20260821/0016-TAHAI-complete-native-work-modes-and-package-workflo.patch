+      case IDC_TAHAI_TRI_VIEW_TWO_OVER_ONE:
+        *accelerator = ui::Accelerator(ui::VKEY_G, kTahaiModifiers);
+        return true;
+      case IDC_TAHAI_TRI_VIEW_ONE_OVER_TWO:
+        *accelerator = ui::Accelerator(ui::VKEY_U, kTahaiModifiers);
+        return true;
+      case IDC_TAHAI_QUAD_VIEW:
+        *accelerator = ui::Accelerator(ui::VKEY_Q, kTahaiModifiers);
+        return true;
+      case IDC_TAHAI_QUAD_FOCUS:
+        *accelerator = ui::Accelerator(ui::VKEY_F, kTahaiModifiers);
+        return true;
+      case IDC_TAHAI_QUAD_EXIT:
+        *accelerator = ui::Accelerator(ui::VKEY_E, kTahaiModifiers);
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (browser_ && chrome::IsCommandEnabled(browser_, command_id)) {
+      chrome::ExecuteCommand(browser_, command_id);
+    }
+  }
+
+ private:
+  const raw_ptr<Browser> browser_;
+};
