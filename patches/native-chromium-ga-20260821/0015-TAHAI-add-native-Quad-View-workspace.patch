+bool IsTahaiQuadView(const Browser* browser) {
+  if (!browser) {
+    return false;
+  }
+  const TabStripModel* model = browser->tab_strip_model();
+  const tabs::TabInterface* active = model->GetActiveTab();
+  if (!active || !active->IsSplit()) {
+    return false;
+  }
+  const size_t member_count =
+      model->GetSplitData(active->GetSplit().value())->ListTabs().size();
+  // Closing a pane intentionally degrades Quad View into the native 3-up
+  // layout. Keep focus and exit controls available so the user is never
+  // stranded in a partially closed workspace.
+  return member_count >= 3u && member_count <= 4u;
+}
+
+bool OpenTahaiQuadView(Browser* browser) {
+  if (!browser || !browser->is_type_normal()) {
+    return false;
+  }
+  TabStripModel* model = browser->tab_strip_model();
+  tabs::TabInterface* original_active = model->GetActiveTab();
+  if (!original_active) {
+    return false;
+  }
+  if (original_active->IsSplit()) {
+    model->RemoveSplit(original_active->GetSplit().value());
+  }
+
+  const int original_index_before_add = model->GetIndexOfTab(original_active);
+  if (original_index_before_add == TabStripModel::kNoTab) {
+    return false;
+  }
+  const bool original_pinned = model->IsTabPinned(original_index_before_add);
+  const std::optional<tab_groups::TabGroupId> original_group =
+      model->GetTabGroupForTab(original_index_before_add);
+  std::vector<tabs::TabInterface*> members = {original_active};
+  for (int index = 0; index < model->count() && members.size() < 4u; ++index) {
+    tabs::TabInterface* candidate = model->GetTabAtIndex(index);
+    if (!candidate->IsSplit() && model->IsTabPinned(index) == original_pinned &&
+        model->GetTabGroupForTab(index) == original_group &&
+        std::ranges::find(members, candidate) == members.end()) {
+      members.push_back(candidate);
+    }
+  }
+  while (members.size() < 4u) {
+    const int prior_count = model->count();
+    const int insertion_index = model->GetIndexOfTab(original_active) + 1;
+    const GURL new_tab_url = browser->profile()->IsIncognitoProfile()
+                                 ? chrome::ChromeUINewTabURLAsGURL()
+                                 : GURL(chrome::kChromeUINewTabURL);
+    model->delegate()->AddTabAt(new_tab_url, insertion_index, true,
+                                original_group, original_pinned);
+    if (model->count() <= prior_count || !model->GetActiveTab()) {
+      return false;
+    }
+    members.push_back(model->GetActiveTab());
+  }
+
+  const int original_index = model->GetIndexOfTab(original_active);
+  if (original_index == TabStripModel::kNoTab) {
+    return false;
+  }
+  model->ActivateTabAt(original_index);
+
+  std::vector<int> indices;
+  indices.reserve(4u);
+  for (tabs::TabInterface* member : members) {
+    const int index = model->GetIndexOfTab(member);
+    if (index == TabStripModel::kNoTab || member->IsSplit()) {
+      return false;
+    }
+    indices.push_back(index);
+  }
+  std::ranges::sort(indices);
+  model->AddToNewTahaiQuad(std::move(indices));
+  return IsTahaiQuadView(browser);
+}
+
+bool SetTahaiQuadFocusMode(Browser* browser, bool enabled) {
+  if (!IsTahaiQuadView(browser)) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view && browser_view->multi_contents_view() &&
+         browser_view->multi_contents_view()->SetTahaiFocusMode(enabled);
+}
+
+bool IsTahaiQuadFocusMode(const Browser* browser) {
+  if (!IsTahaiQuadView(browser)) {
+    return false;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForBrowser(const_cast<Browser*>(browser));
+  return browser_view && browser_view->multi_contents_view() &&
+         browser_view->multi_contents_view()->IsTahaiFocusMode();
+}
+
+bool ExitTahaiQuadView(Browser* browser) {
+  if (!IsTahaiQuadView(browser)) {
+    return false;
+  }
+  TabStripModel* model = browser->tab_strip_model();
+  model->RemoveSplit(model->GetActiveTab()->GetSplit().value());
+  return !IsTahaiQuadView(browser);
+}
