+TEST_F(TabRestoreServiceImplWithMockClientTest,
+       TahaiQuadCloseAndRestorePreservesAllPanes) {
+  ON_CALL(*mock_tab_restore_service_client_, ShouldTrackURLForRestore(_))
+      .WillByDefault(Return(true));
+  testing::NiceMock<MockLiveTabContext> mock_live_tab_context;
+  testing::NiceMock<MockLiveTab> mock_tabs[4];
+  const split_tabs::SplitTabId quad_id = split_tabs::SplitTabId::GenerateNew();
+
+  ON_CALL(mock_live_tab_context, GetSessionID())
+      .WillByDefault(Return(SessionID::NewUnique()));
+  ON_CALL(mock_live_tab_context, GetTabCount()).WillByDefault(Return(4));
+  ON_CALL(mock_live_tab_context, GetSplitForTab(_))
+      .WillByDefault(Return(quad_id));
+  ON_CALL(mock_live_tab_context, GetLiveTabAt(_))
+      .WillByDefault(
+          testing::Invoke([&mock_tabs](int index) -> sessions::LiveTab* {
+            return index >= 0 && index < 4 ? &mock_tabs[index] : nullptr;
+          }));
+
+  for (int i = 0; i < 4; ++i) {
+    ON_CALL(mock_tabs[i], GetSessionID())
+        .WillByDefault(Return(SessionID::NewUnique()));
+    ON_CALL(mock_tabs[i], GetEntryCount()).WillByDefault(Return(1));
+    ON_CALL(mock_tabs[i], GetEntryAtIndex(_))
+        .WillByDefault(Return(sessions::ContentTestHelper::CreateNavigation(
+            base::StringPrintf("http://quad%d", i + 1),
+            base::StringPrintf("Q%d", i + 1))));
+  }
+  ON_CALL(*mock_tab_restore_service_client_, FindLiveTabContextForTab(_))
+      .WillByDefault(Return(&mock_live_tab_context));
+
+  size_t restore_index = 0u;
+  ON_CALL(mock_live_tab_context, AddRestoredTab(_, _, _, _, _))
+      .WillByDefault(
+          testing::Invoke([&mock_tabs, &restore_index](
+                              const sessions::tab_restore::Tab&, int, bool,
+                              bool, sessions::tab_restore::Type) {
+            return restore_index < 4u ? &mock_tabs[restore_index++] : nullptr;
+          }));
+
+  service_->CreateHistoricalSplit(&mock_live_tab_context, quad_id);
+  ASSERT_EQ(1u, service_->entries().size());
+  ASSERT_EQ(sessions::tab_restore::Type::SPLIT,
+            service_->entries().front()->type);
+  ASSERT_EQ(4u, static_cast<sessions::tab_restore::Split*>(
+                    service_->entries().front().get())
+                    ->tabs.size());
+
+  // The pane count is part of the persisted command, so reopening the service
+  // must not truncate a Quad back to Chromium's historical two-pane shape.
+  RecreateService();
+  ASSERT_EQ(1u, service_->entries().size());
+  auto& restored_entry = service_->entries().front();
+  ASSERT_EQ(sessions::tab_restore::Type::SPLIT, restored_entry->type);
+  ASSERT_EQ(4u, static_cast<sessions::tab_restore::Split*>(restored_entry.get())
+                    ->tabs.size());
+
+  EXPECT_CALL(mock_live_tab_context,
+              ReconstructSplit(testing::SizeIs(4), quad_id, _))
+      .Times(1);
+  service_->RestoreEntryById(&mock_live_tab_context, restored_entry->id,
+                             WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  EXPECT_TRUE(service_->entries().empty());
+}
