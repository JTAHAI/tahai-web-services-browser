+IN_PROC_BROWSER_TEST_F(SessionRestoreTest, TahaiQuadViewRestored) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GetUrl1()));
+  for (int index = 1; index < 4; ++index) {
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(), index % 2 ? GetUrl2() : GetUrl1(),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP);
+  }
+  TabStripModel* model = browser()->tab_strip_model();
+  ASSERT_EQ(model->count(), 4);
+  model->ActivateTabAt(2);
+  model->AddToNewTahaiQuad({0, 1, 2, 3});
+
+  BrowserWindowInterface* restored = QuitBrowserAndRestore(browser());
+  TabStripModel* restored_model = restored->GetTabStripModel();
+  ASSERT_EQ(restored_model->count(), 4);
+  ASSERT_EQ(restored_model->ListSplits().size(), 1u);
+  const split_tabs::SplitTabId split_id = *restored_model->ListSplits().begin();
+  const std::vector<tabs::TabInterface*> restored_members =
+      restored_model->GetSplitData(split_id)->ListTabs();
+  ASSERT_EQ(restored_members.size(), 4u);
+  for (int index = 0; index < 4; ++index) {
+    EXPECT_EQ(restored_members[index], restored_model->GetTabAtIndex(index));
+    EXPECT_EQ(restored_model->GetSplitForTab(index), split_id);
+  }
+  EXPECT_EQ(restored_model->active_index(), 2);
+}
