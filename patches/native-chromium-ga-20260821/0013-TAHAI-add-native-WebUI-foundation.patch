+// Copyright 2026 TAHAI Web Services
+// SPDX-License-Identifier: Apache-2.0
+
+#ifndef CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_UI_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace tahai {
+
+class TahaiPlaceholderSource : public content::URLDataSource {
+ public:
+  TahaiPlaceholderSource(std::string host,
+                         std::string surface,
+                         std::string title);
+  TahaiPlaceholderSource(const TahaiPlaceholderSource&) = delete;
+  TahaiPlaceholderSource& operator=(const TahaiPlaceholderSource&) = delete;
+  ~TahaiPlaceholderSource() override;
+
+  std::string GetSource() override;
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override;
+  std::string GetMimeType(const GURL& url) override;
+
+ private:
+  const std::string host_;
+  const std::string surface_;
+  const std::string title_;
+};
+
+class TahaiUI : public content::WebUIController {
+ public:
+  TahaiUI(content::WebUI* web_ui,
+          std::string_view internal_host,
+          std::string_view surface,
+          std::string_view title);
+  TahaiUI(const TahaiUI&) = delete;
+  TahaiUI& operator=(const TahaiUI&) = delete;
+  ~TahaiUI() override;
+};
+
+class TahaiSurfaceUIConfig : public content::WebUIConfig {
+ public:
+  TahaiSurfaceUIConfig(std::string_view host,
+                       std::string_view surface,
+                       std::string_view title);
+  TahaiSurfaceUIConfig(const TahaiSurfaceUIConfig&) = delete;
+  TahaiSurfaceUIConfig& operator=(const TahaiSurfaceUIConfig&) = delete;
+  ~TahaiSurfaceUIConfig() override;
+
+  std::unique_ptr<content::WebUIController> CreateWebUIController(
+      content::WebUI* web_ui,
+      const GURL& url) override;
+
+ private:
+  const std::string host_;
+  const std::string surface_;
+  const std::string title_;
+};
+
+class TahaiNewTabUIConfig : public TahaiSurfaceUIConfig {
+ public:
+  TahaiNewTabUIConfig();
+  ~TahaiNewTabUIConfig() override;
+};
+
+class TahaiMissionUIConfig : public TahaiSurfaceUIConfig {
+ public:
+  TahaiMissionUIConfig();
+  ~TahaiMissionUIConfig() override;
+};
+
+class TahaiOpsToolsUIConfig : public TahaiSurfaceUIConfig {
+ public:
+  TahaiOpsToolsUIConfig();
+  ~TahaiOpsToolsUIConfig() override;
+};
+
+class TahaiSupportUIConfig : public TahaiSurfaceUIConfig {
+ public:
+  TahaiSupportUIConfig();
+  ~TahaiSupportUIConfig() override;
+};
+
+class TahaiPolicyUIConfig : public TahaiSurfaceUIConfig {
+ public:
+  TahaiPolicyUIConfig();
+  ~TahaiPolicyUIConfig() override;
+};
+
+}  // namespace tahai
+
+#endif  // CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_UI_H_
diff --git a/chrome/browser/ui/webui/tahai/tahai_url_rewrite.h b/chrome/browser/ui/webui/tahai/tahai_url_rewrite.h
