--- /dev/null
+++ b/chrome/browser/ui/webui/tahai/tahai_url_rewrite.h
@@ -0,0 +1,75 @@
+// Copyright 2026 TAHAI Web Services
+// SPDX-License-Identifier: Apache-2.0
+
+#ifndef CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_URL_REWRITE_H_
+#define CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_URL_REWRITE_H_
+
+#include <string_view>
+
+#include "chrome/common/tahai_url_constants.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/common/url_constants.h"
+#include "url/gurl.h"
+
+namespace tahai {
+
+inline const char* InternalHostForPublicHost(std::string_view host) {
+  if (host == kTahaiNewTabHost)
+    return kTahaiInternalNewTabHost;
+  if (host == kTahaiMissionHost)
+    return kTahaiInternalMissionHost;
+  if (host == kTahaiOpsToolsHost)
+    return kTahaiInternalOpsToolsHost;
+  if (host == kTahaiSupportHost)
+    return kTahaiInternalSupportHost;
+  if (host == kTahaiPolicyHost)
+    return kTahaiInternalPolicyHost;
+  return nullptr;
+}
+
+inline const char* PublicHostForInternalHost(std::string_view host) {
+  if (host == kTahaiInternalNewTabHost)
+    return kTahaiNewTabHost;
+  if (host == kTahaiInternalMissionHost)
+    return kTahaiMissionHost;
+  if (host == kTahaiInternalOpsToolsHost)
+    return kTahaiOpsToolsHost;
+  if (host == kTahaiInternalSupportHost)
+    return kTahaiSupportHost;
+  if (host == kTahaiInternalPolicyHost)
+    return kTahaiPolicyHost;
+  return nullptr;
+}
+
+inline bool HandleTahaiURLRewrite(GURL* url,
+                                  content::BrowserContext* browser_context) {
+  if (!url || !url->SchemeIs(kTahaiScheme))
+    return false;
+  const char* internal_host = InternalHostForPublicHost(url->host());
+  if (!internal_host)
+    return false;
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(content::kChromeUIScheme);
+  replacements.SetHostStr(internal_host);
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
+
+inline bool HandleTahaiURLReverseRewrite(
+    GURL* url,
+    content::BrowserContext* browser_context) {
+  if (!url || !url->SchemeIs(content::kChromeUIScheme))
+    return false;
+  const char* public_host = PublicHostForInternalHost(url->host());
+  if (!public_host)
+    return false;
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(kTahaiScheme);
+  replacements.SetHostStr(public_host);
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
+
+}  // namespace tahai
+
+#endif  // CHROME_BROWSER_UI_WEBUI_TAHAI_TAHAI_URL_REWRITE_H_
