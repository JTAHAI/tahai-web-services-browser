@@ -0,0 +1,131 @@
+// Copyright 2026 TAHAI Web Services
+// SPDX-License-Identifier: Apache-2.0
+
+#include "chrome/browser/ui/webui/tahai/tahai_ui.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/check.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/ref_counted_memory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/tahai_url_constants.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/common/url_constants.h"
+#include "url/gurl.h"
+
+namespace tahai {
+namespace {
+
+constexpr char kNewTabSurface[] = "newtab";
+constexpr char kMissionSurface[] = "mission";
+constexpr char kOpsToolsSurface[] = "ops-tools";
+constexpr char kSupportSurface[] = "support";
+constexpr char kPolicySurface[] = "policy";
+constexpr char kNewTabTitle[] = "TAHAI New Tab";
+constexpr char kMissionTitle[] = "Mission Control";
+constexpr char kOpsToolsTitle[] = "Operations Tools";
+constexpr char kSupportTitle[] = "TAHAI Support";
+constexpr char kPolicyTitle[] = "TAHAI Policy";
+
+}  // namespace
+
+TahaiPlaceholderSource::TahaiPlaceholderSource(std::string host,
+                                               std::string surface,
+                                               std::string title)
+    : host_(std::move(host)),
+      surface_(std::move(surface)),
+      title_(std::move(title)) {}
+
+TahaiPlaceholderSource::~TahaiPlaceholderSource() = default;
+
+std::string TahaiPlaceholderSource::GetSource() {
+  return host_;
+}
+
+void TahaiPlaceholderSource::StartDataRequest(
+    const GURL& url,
+    const content::WebContents::Getter& wc_getter,
+    GotDataCallback callback) {
+  // This foundation serves only bundled, non-scripted content. It does not
+  // inspect page state, browser storage, authentication, or remote resources.
+  std::string html =
+      "<!doctype html><html><head><meta charset=utf-8>"
+      "<meta name=viewport content=width=device-width><title>" +
+      title_ + "</title></head><body data-tahai-surface=\"" + surface_ +
+      "\"><main><h1>" + title_ +
+      "</h1><p>Native TAHAI WebUI foundation ready.</p></main></body></html>";
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(html)));
+}
+
+std::string TahaiPlaceholderSource::GetMimeType(const GURL& url) {
+  return "text/html";
+}
+
+TahaiUI::TahaiUI(content::WebUI* web_ui,
+                 std::string_view internal_host,
+                 std::string_view surface,
+                 std::string_view title)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  CHECK(profile);
+  content::URLDataSource::Add(
+      profile, std::make_unique<TahaiPlaceholderSource>(
+                   std::string(internal_host), std::string(surface),
+                   std::string(title)));
+}
+
+TahaiUI::~TahaiUI() = default;
+
+TahaiSurfaceUIConfig::TahaiSurfaceUIConfig(std::string_view host,
+                                           std::string_view surface,
+                                           std::string_view title)
+    : content::WebUIConfig(content::kChromeUIScheme, std::string(host)),
+      host_(host),
+      surface_(surface),
+      title_(title) {}
+
+TahaiSurfaceUIConfig::~TahaiSurfaceUIConfig() = default;
+
+std::unique_ptr<content::WebUIController>
+TahaiSurfaceUIConfig::CreateWebUIController(content::WebUI* web_ui,
+                                            const GURL& url) {
+  return std::make_unique<TahaiUI>(web_ui, host_, surface_, title_);
+}
+
+TahaiNewTabUIConfig::TahaiNewTabUIConfig()
+    : TahaiSurfaceUIConfig(kTahaiInternalNewTabHost,
+                           kNewTabSurface,
+                           kNewTabTitle) {}
+TahaiNewTabUIConfig::~TahaiNewTabUIConfig() = default;
+
+TahaiMissionUIConfig::TahaiMissionUIConfig()
+    : TahaiSurfaceUIConfig(kTahaiInternalMissionHost,
+                           kMissionSurface,
+                           kMissionTitle) {}
+TahaiMissionUIConfig::~TahaiMissionUIConfig() = default;
+
+TahaiOpsToolsUIConfig::TahaiOpsToolsUIConfig()
+    : TahaiSurfaceUIConfig(kTahaiInternalOpsToolsHost,
+                           kOpsToolsSurface,
+                           kOpsToolsTitle) {}
+TahaiOpsToolsUIConfig::~TahaiOpsToolsUIConfig() = default;
+
+TahaiSupportUIConfig::TahaiSupportUIConfig()
+    : TahaiSurfaceUIConfig(kTahaiInternalSupportHost,
+                           kSupportSurface,
+                           kSupportTitle) {}
+TahaiSupportUIConfig::~TahaiSupportUIConfig() = default;
+
+TahaiPolicyUIConfig::TahaiPolicyUIConfig()
+    : TahaiSurfaceUIConfig(kTahaiInternalPolicyHost,
+                           kPolicySurface,
+                           kPolicyTitle) {}
+TahaiPolicyUIConfig::~TahaiPolicyUIConfig() = default;
+
+}  // namespace tahai
