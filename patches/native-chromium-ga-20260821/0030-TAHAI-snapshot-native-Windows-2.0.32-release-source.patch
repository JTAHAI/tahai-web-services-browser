@@ -0,0 +1,453 @@
+// Copyright 2026 TAHAI Web Services
+// SPDX-License-Identifier: Apache-2.0
+
+#include "chrome/browser/ui/tahai/tahai_guard_panel.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
