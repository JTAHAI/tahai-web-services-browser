+struct TestRequest {
+    frameUrl: String,
+    url: String,
+    cpt: String,
+}
+
+fn load_requests() -> Vec<TestRequest> {
+    rules_from_lists(&["data/requests.json"])
+        .map(|r| serde_json::from_str(&r))
+        .filter_map(Result::ok)
+        .collect::<Vec<_>>()
+}
