+    {"tahai-neon", "TAHAI Neon", "Original neon operator concept.", false},
+    {"tahai-sentinel", "TAHAI Sentinel", "Original signal-focused concept.",
+     false},
+    {"terminal-green", "Terminal Green", "Original terminal-inspired concept.",
