+void MultiContentsViewDelegateImpl::ResizeTahaiGrid(double row_ratio,
+                                                    double column_ratio,
+                                                    bool done_resizing) {
+  const tabs::TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+  if (!active_tab || !active_tab->GetSplit().has_value()) {
+    return;
+  }
+  const split_tabs::SplitTabId split_id = active_tab->GetSplit().value();
+  tab_strip_model_->UpdateTahaiGridRatios(split_id, row_ratio, column_ratio,
+                                          !done_resizing);
+  // Persist once at the end, even if the final drag delta equals the previous
+  // intermediate update. Never obtain a redirected regular-profile service.
+  if (done_resizing && !browser_->profile()->IsOffTheRecord()) {
+    if (auto* service =
+            SessionServiceFactory::GetForProfile(browser_->profile())) {
+      service->SetSplitTabData(
+          browser_->session_id(), split_id,
+          tab_strip_model_->GetSplitData(split_id)->visual_data());
+    }
+  }
+}
