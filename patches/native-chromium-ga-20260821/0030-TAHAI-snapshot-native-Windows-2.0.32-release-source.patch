+
+void ToolbarView::UpdateTahaiModeControls() {
+  if (!tahai_window_mode_controller_ || !tahai_mode_button_ ||
+      !tahai_primary_button_ || !tahai_secondary_button_) {
+    return;
+  }
+
+  const tahai::WorkModeDefinition& mode =
+      tahai_window_mode_controller_->active_mode();
+  const std::u16string mode_title = base::UTF8ToUTF16(mode.title);
+  std::u16string primary_label;
+  std::u16string secondary_label;
+  const gfx::VectorIcon* primary_icon = &kHomeIcon;
+  const gfx::VectorIcon* secondary_icon = &kPersonFilledIcon;
+  if (mode.id == "daily") {
+    primary_label = u"Workspace";
+    secondary_label = u"Profiles";
+  } else if (mode.id == "creator") {
+    primary_label = u"Workspace";
+    secondary_label = u"Command Center";
+    primary_icon = &kEditIcon;
+    secondary_icon = &kRocketLaunchIcon;
+  } else if (mode.id == "builder") {
+    primary_label = u"Workspace";
+    secondary_label = u"Command Center";
+    primary_icon = &kCodeIcon;
+    secondary_icon = &kTaskSparkIcon;
+  } else if (mode.id == "operator") {
+    primary_label = u"Mission";
+    secondary_label = u"Support";
+    primary_icon = &kSpeedIcon;
+    secondary_icon = &kTableChartIcon;
+  } else if (mode.id == "research") {
+    primary_label = u"Workspace";
+    secondary_label = u"Profiles";
+    primary_icon = &kScienceIcon;
+    secondary_icon = &kMenuBookIcon;
+  } else {
+    primary_label = u"Support";
+    secondary_label = u"Policy";
+    primary_icon = &kHelpCustomIcon;
+    secondary_icon = &kTaskManagerOldIcon;
+  }
+
+  tahai_mode_button_->SetHighlight(mode_title, std::nullopt);
+  tahai_mode_button_->GetViewAccessibility().SetName(
+      u"Choose TAHAI work mode: " + mode_title);
+  tahai_mode_button_->SetTooltipText(u"Mode: " + mode_title +
+                                     u" (choose work mode)");
+  tahai_primary_button_->SetHighlight(primary_label, std::nullopt);
+  tahai_primary_button_->GetViewAccessibility().SetName(mode_title +
+                                                        u" primary actions");
+  tahai_primary_button_->SetTooltipText(mode_title + u" primary actions");
+  tahai_primary_button_->SetVectorIcon(*primary_icon);
+  tahai_secondary_button_->SetHighlight(secondary_label, std::nullopt);
+  tahai_secondary_button_->GetViewAccessibility().SetName(
+      mode_title + u" secondary actions");
+  tahai_secondary_button_->SetTooltipText(mode_title + u" secondary actions");
+  tahai_secondary_button_->SetVectorIcon(*secondary_icon);
+  InvalidateLayout();
+}
+
+void ToolbarView::UpdateTahaiEnvironmentGuard(WebContents* tab) {
+  if (!tahai_environment_button_) {
+    return;
+  }
+  if (!tab) {
+    tab = browser_->tab_strip_model()->GetActiveWebContents();
+  }
+  const std::optional<tahai::TahaiEnvironmentGuardRule> rule =
+      tab ? tahai::FindTahaiEnvironmentGuardRule(
+                browser_->profile()->GetPrefs(), tab->GetVisibleURL())
+          : std::nullopt;
+  if (!rule || !rule->posture.show_persistent_boundary) {
+    tahai_environment_button_->SetVisible(false);
+    tahai_environment_button_->SetHighlight(std::u16string(), std::nullopt);
+    InvalidateLayout();
+    return;
+  }
+
+  const std::u16string label = base::UTF8ToUTF16(rule->posture.label);
+  tahai_environment_button_->SetHighlight(label, std::nullopt);
+  tahai_environment_button_->SetTooltipText(
+      label + u" Environment Guard boundary. Open Local OI settings.");
+  tahai_environment_button_->GetViewAccessibility().SetName(
+      label + u" Environment Guard boundary");
+  tahai_environment_button_->SetVisible(true);
+  InvalidateLayout();
+}
