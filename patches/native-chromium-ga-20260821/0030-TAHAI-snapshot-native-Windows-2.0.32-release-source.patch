+// contain package bytes, paths, URLs, CSS, scripts, or security-surface data.
+inline constexpr char kTahaiSkinSelection[] = "tahai.skin_selection";
+
+// Effective profile/managed controls for the native local skin package owner.
+// No archive, pixels or transport credentials live in these preferences.
+inline constexpr char kTahaiSkinsEnabled[] = "tahai.skins_enabled";
+inline constexpr char kTahaiSkinInstallationsAllowed[] =
+    "tahai.skin_installations_allowed";
+
+// OS-protected TAHAI Sync envelope keys. The preference contains only
+// OSCrypt-wrapped random key material and public key identifiers; it never
+// stores an OAuth credential, browser session, password, or plaintext key.
+inline constexpr char kTahaiSyncKeyring[] = "tahai.sync_keyring";
+
+// Controls only opt-in fixed hosted-Operational-Intelligence referral
+// affordances. It never enables upload, accounts, connectors, or telemetry. A
+// managed preference value, when deployed by an enterprise integrator,
+// overrides the profile's local choice.
+inline constexpr char kTahaiLocalOiMspPromotionEnabled[] =
+    "tahai.local_oi_msp_promotion_enabled";
+
+// Versioned, profile-local TAHAI Operational Intelligence data. The document
+// contains only validated records created by explicit TAHAI sources. It never
+// stores browser history by default, page bodies, cookies, credentials, form
+// content, authentication material, or a profile identifier.
+inline constexpr char kTahaiLocalOiStore[] = "tahai.local_oi_store";
+inline constexpr char kTahaiLocalOiEnabled[] = "tahai.local_oi_enabled";
+inline constexpr char kTahaiLocalOiRetentionDays[] =
+    "tahai.local_oi_retention_days";
+inline constexpr char kTahaiLocalOiMissionIngestionEnabled[] =
+    "tahai.local_oi_mission_ingestion_enabled";
+inline constexpr char kTahaiLocalOiArtifactIngestionEnabled[] =
+    "tahai.local_oi_artifact_ingestion_enabled";
+inline constexpr char kTahaiLocalOiDocumentationReferenceIngestionEnabled[] =
+    "tahai.local_oi_documentation_reference_ingestion_enabled";
+inline constexpr char kTahaiLocalOiOpsToolIngestionEnabled[] =
+    "tahai.local_oi_ops_tool_ingestion_enabled";
+inline constexpr char kTahaiLocalOiHistoryMetadataEnabled[] =
+    "tahai.local_oi_history_metadata_enabled";
+inline constexpr char kTahaiLocalOiReportsEnabled[] =
+    "tahai.local_oi_reports_enabled";
+inline constexpr char kTahaiLocalOiExportEnabled[] =
+    "tahai.local_oi_export_enabled";
+inline constexpr char kTahaiLocalOiLocalAiEnabled[] =
+    "tahai.local_oi_local_ai_enabled";
+
 }  // namespace prefs
 
