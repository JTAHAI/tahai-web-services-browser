+  EXPECT_FALSE(local_oi.ResolveFinding(finding.id, "Blocked action."));
+  EXPECT_FALSE(local_oi.SuppressFinding(finding.id, "Blocked action."));
+  EXPECT_FALSE(local_oi.ReopenFinding(finding.id, "Blocked action."));
