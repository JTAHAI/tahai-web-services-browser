+// Copyright 2026 TAHAI Web Services
+// SPDX-License-Identifier: Apache-2.0
+
+#include "chrome/browser/ui/tahai/tahai_workspace_rail_view.h"
+
+#include <algorithm>
+#include <array>
+#include <iterator>
+#include <ranges>
+#include <string_view>
+
+#include "base/check.h"
