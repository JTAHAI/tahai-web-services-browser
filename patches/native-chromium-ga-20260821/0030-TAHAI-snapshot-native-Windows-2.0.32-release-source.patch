+    pub fn contains(&self, key: I) -> bool {
+        self.view.get_single(key).is_some()
+    }
+
+    #[cfg(test)]
+    pub fn len(&self) -> usize {
+        self.view.len()
+    }
+
+    #[cfg(test)]
