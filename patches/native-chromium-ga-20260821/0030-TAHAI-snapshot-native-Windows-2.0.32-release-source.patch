+  TahaiLocalOiRuleEngine(const TahaiLocalOiRuleEngine&) = delete;
+  TahaiLocalOiRuleEngine& operator=(const TahaiLocalOiRuleEngine&) = delete;
+  ~TahaiLocalOiRuleEngine();
