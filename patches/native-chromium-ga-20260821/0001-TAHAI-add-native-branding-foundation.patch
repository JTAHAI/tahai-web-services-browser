diff --git a/build/config/chrome_build.gni b/build/config/chrome_build.gni
index d80c9ff95a2b0b593a3872be0227d882d5fd81f7..0893e8d9da0901c9d84ca7eac6f0320bedf4a0b7 100644
--- a/build/config/chrome_build.gni
+++ b/build/config/chrome_build.gni
@@ -11,6 +11,9 @@ declare_args() {
   # resources).
   is_chrome_branded = false
 
+  # Enable lawful TAHAI-owned browser branding without Google Chrome assets.
+  is_tahai_branded = false
+
   # Whether to enable Google internal-only sources.
   enable_src_internal =
       (build_with_chromium && checkout_src_internal) ||
@@ -73,6 +76,9 @@ declare_args() {
 assert(!is_chrome_for_testing || !is_chrome_branded,
        "`is_chrome_for_testing` is incompatible with `is_chrome_branded`")
 
+assert(!is_tahai_branded || (!is_chrome_branded && !is_chrome_for_testing),
+       "`is_tahai_branded` requires Chromium branding and is incompatible with Chrome for Testing")
+
 assert(is_chrome_for_testing || !is_chrome_for_testing_branded,
        "`is_chrome_for_testing_branded` requires `is_chrome_for_testing`")
 
@@ -81,7 +87,10 @@ declare_args() {
   # chrome/app/theme.
   #
   # `branding_path_product` must not contain slashes.
-  if (is_chrome_for_testing) {
+  if (is_tahai_branded) {
+    branding_path_component = "tahai"
+    branding_path_product = "tahai"
+  } else if (is_chrome_for_testing) {
     if (is_chrome_for_testing_branded) {
       branding_path_component = "google_chrome/google_chrome_for_testing"
     } else {
