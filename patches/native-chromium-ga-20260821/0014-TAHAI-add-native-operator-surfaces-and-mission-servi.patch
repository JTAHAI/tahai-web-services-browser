+std::optional<int> CommandId(std::string_view command) {
+  if (command == "tab.new") {
+    return IDC_NEW_TAB;
+  }
+  if (command == "tab.reload") {
+    return IDC_RELOAD;
+  }
+  if (command == "tab.close") {
+    return IDC_CLOSE_TAB;
+  }
+  if (command == "capture.print") {
+    return IDC_PRINT;
+  }
+  if (command == "export.save-page") {
+    return IDC_SAVE_PAGE;
+  }
+  return std::nullopt;
+}
