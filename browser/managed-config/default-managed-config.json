{
  "product": "TAHAI Web Services Browser",
  "version": "2.0.14",
  "defaultHome": "https://tahaiportal.com",
  "startup": "home",
  "searchProvider": "google",
  "permissions": {
    "allowClipboardRead": false,
    "allowMedia": true,
    "allowGeolocation": false,
    "allowNotifications": false
  },
  "downloads": {
    "askEveryTime": true,
    "defaultDirectory": "",
    "blockInsecureDownloads": true
  },
  "ui": {
    "showStatusBar": true,
    "openExternalLinksInNewTab": true,
    "allowPopupsAsTabs": true,
    "defaultZoomPercent": 100,
    "launchToMaximized": false,
    "confirmBeforeClosingMultipleTabs": false
  },
  "enterpriseControls": {
    "homepageCanBeChangedByUser": true,
    "allowUnsafeLocalFileNavigation": false,
    "blockDangerousProtocols": ["ftp:", "gopher:", "javascript:", "data:"],
    "sourceTreeMustExcludeRuntimeProfile": true,
    "sourceTreeMustExcludeBuildOutputs": true
  }
}
