  "build": {
    "appId": "com.tahai.webservices.browser",
    "productName": "TAHAI Web Services Browser",
    "executableName": "TAHAI Web Services Browser",
    "copyright": "Copyright (c) 2026 TAHAI Web Services",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "TAHAI-Web-Services-Browser-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAHAI Web Services Browser",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAHAI Web Services Browser"
    },
    "extraResources": [
      {
        "from": "browser",
        "to": "browser"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/brand/tahai-spider-icon.ico",
        "to": "assets/brand/tahai-spider-icon.ico"
      },
      {
        "from": "assets/brand/tahai-spider-icon.png",
        "to": "assets/brand/tahai-spider-icon.png"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "build/**/*",
      "browser/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "publish": null,
    "removePackageScripts": true,
    "nodeGypRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JTAHAI/tahai-web-services-browser.git"
  },
  "bugs": {
    "url": "https://github.com/JTAHAI/tahai-web-services-browser/issues"
  },
  "keywords": [
    "electron",
    "chromium",
    "browser",
    "devops",
    "it-engineering",
    "developer-tools",
    "tahai"
  ]
